# Alertmanager config template (routing rules are readable; secrets are placeholders).
# deployment/secrets/sealSecrets.sh substitutes the __PLACEHOLDERS__ with values from
# the Pulumi stack and seals the result as the 'alertmanager-config' secret
# (key alertmanager.yaml) in the prometheus namespace. Nothing here is committed
# with real SMTP credentials or recipient — only this template with placeholders.
global:
  resolve_timeout: 5m
  smtp_from: '__SMTP_FROM__'
  smtp_smarthost: '__SMTP_SMARTHOST__'
  smtp_require_tls: true
  smtp_auth_username: '__SMTP_USERNAME__'
  smtp_auth_password: '__SMTP_PASSWORD__'
inhibit_rules:
  - equal: [namespace, alertname]
    source_matchers: ["severity = critical"]
    target_matchers: ["severity =~ warning|info"]
  - equal: [namespace, alertname]
    source_matchers: ["severity = warning"]
    target_matchers: ["severity = info"]
  - equal: [namespace]
    source_matchers: ["alertname = InfoInhibitor"]
    target_matchers: ["severity = info"]
receivers:
  - name: "null"
  - name: email
    email_configs:
      - to: '__RECIPIENT__'
        send_resolved: true
        headers:
          Subject: '[ecc] {{ .GroupLabels.alertname }} — {{ .Status | toUpper }}'
route:
  receiver: "null"
  group_by: [alertname, namespace]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 24h
  routes:
    - matchers: ['alertname = "Watchdog"']
      receiver: "null"
    - matchers: ['alertname =~ "Longhorn.*"']
      receiver: email
    - matchers: ['alertname =~ "ArgoCD.*"']
      receiver: email
