# CloudNativePG cluster for Authentik.
# - Live data stored on longhorn
# - WAL archiving + scheduled base backups go to Hetzner S3 every 10 minutes
# - Bootstrap: always initdb (fresh database on every new cluster)
#   For manual restore from S3, patch cluster bootstrap to use recovery mode.
#
# Image versions: https://github.com/cloudnative-pg/postgres-containers/releases
#
# DO NOT EDIT postgres.yaml directly — generated by sealSecrets.sh from this template.
# Placeholders: BUCKET_NAME, S3_BASE_ENDPOINT
---
# CNPG Cluster — sealed secrets at sync-wave -1 ensure authentik-pg-user and
# authentik-s3-secret exist before CNPG reconciles the Cluster at wave 0.
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: authentik-pg
  namespace: authentik
  annotations:
    argocd.argoproj.io/sync-wave: "0"
spec:
  priorityClassName: essential
  instances: 3 # project-settings: ha.authentikPg
  # Spread instances across nodes when HA. enablePodAntiAffinity is flipped by
  # updateConfigFromProjectSettings.sh from general.highAvailability; preferred (soft)
  # so a single-node/HA-off cluster never wedges the extra instance Pending.
  affinity:
    enablePodAntiAffinity: true # project-settings: haAffinity.authentikPg
    podAntiAffinityType: preferred
    topologyKey: kubernetes.io/hostname
  # Check https://github.com/cloudnative-pg/postgres-containers/releases for newer versions
  imageName: ghcr.io/cloudnative-pg/postgresql:18 # renovate: datasource=docker depName=ghcr.io/cloudnative-pg/postgresql

  storage:
    storageClass: longhorn-cloud
    size: 8Gi

  bootstrap:
    initdb:
      database: authentik
      owner: authentik
      secret:
        name: authentik-pg-user

  backup:
    barmanObjectStore:
      destinationPath: "s3://BUCKET_NAME/authentik-pg"
      endpointURL: "https://S3_BASE_ENDPOINT"
      s3Credentials:
        accessKeyId:
          name: authentik-s3-secret
          key: ACCESS_KEY_ID
        secretAccessKey:
          name: authentik-s3-secret
          key: SECRET_ACCESS_KEY
      wal:
        compression: gzip
      data:
        compression: gzip
    retentionPolicy: "30d"

---
# Scheduled base backup every 10 minutes
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: authentik-pg-backup
  namespace: authentik
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  schedule: "*/10 * * * *"
  backupOwnerReference: self
  cluster:
    name: authentik-pg
