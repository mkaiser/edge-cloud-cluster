# Alertmanager config template (routing rules are readable; secrets are placeholders).
# sealSecrets.sh beside this file substitutes the __PLACEHOLDERS__ with values from
# the Pulumi stack and seals the result as the 'alertmanager-config' secret
# (key alertmanager.yaml) in the prometheus namespace. Nothing here is committed
# with real SMTP credentials or recipient — only this template with placeholders.
global:
  resolve_timeout: 5m
  smtp_from: '__SMTP_FROM__'
  smtp_smarthost: '__SMTP_SMARTHOST__'
  smtp_require_tls: true
  smtp_auth_username: '__SMTP_USERNAME__'
  smtp_auth_password: '__SMTP_PASSWORD__'
inhibit_rules:
  - equal: [namespace, alertname]
    source_matchers: ["severity = critical"]
    target_matchers: ["severity =~ warning|info"]
  - equal: [namespace, alertname]
    source_matchers: ["severity = warning"]
    target_matchers: ["severity = info"]
  - equal: [namespace]
    source_matchers: ["alertname = InfoInhibitor"]
    target_matchers: ["severity = info"]
receivers:
  - name: "null"
  - name: email
    email_configs:
      - to: '__RECIPIENT__'
        send_resolved: true
        headers:
          Subject: '[ecc] {{ .GroupLabels.alertname }} — {{ .Status | toUpper }}'
# ⚠ THE DEFAULT RECEIVER MUST DELIVER. This was `receiver: "null"` with an ALLOW-LIST of
# two alertname prefixes (Longhorn.*, ArgoCD.*) routed to email — so every other alert in the
# cluster fired into a black hole: it appeared in the Prometheus and Alertmanager UIs, it was
# grouped and it was inhibited correctly, and nobody was ever told. Verified 2026-09-03 on
# the live config, where it silently swallowed every Mesh*, GitLab*, Kube* critical and every
# rule group added since — an allow-list keyed on names quietly excludes each new alert
# somebody writes, which is the failure mode this whole monitoring pass kept finding.
# Route on SEVERITY instead: everything is delivered unless it is explicitly not worth an
# email. Watchdog is the deliberate exception — it fires forever by design, to prove the
# pipeline works — and `info` is diagnostic padding the inhibit rules above already suppress.
route:
  receiver: email
  group_by: [alertname, namespace]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 24h
  routes:
    - matchers: ['alertname = "Watchdog"']
      receiver: "null"
    - matchers: ['alertname = "InfoInhibitor"']
      receiver: "null"
    - matchers: ['severity = "info"']
      receiver: "null"
    - matchers: ['severity = "none"']
      receiver: "null"
