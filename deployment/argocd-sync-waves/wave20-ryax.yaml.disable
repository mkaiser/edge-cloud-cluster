# ArgoCD Application: Ryax workflow-automation engine (OCI Helm chart).
# Accessible at https://ryax.ecc135.cape-project.eu  (HAProxy terminates TLS).
#
# Ryax has its OWN username/password auth (RYAX_DEFAULT_USER_*, from the sealed
# ryax-admin-credentials secret) and NO OIDC support in its charts, so Authentik
# integration is a link-only portal tile (authentik-blueprint.yaml), not SSO.
# All config lives in deployment/apps/ryax.
#
# IMPORTANT — fresh-install deadlock: the chart ships DB-migration / scale-down
# jobs as helm `pre-upgrade` hooks (datastore/runner/studio subcharts). ArgoCD has
# no install/upgrade distinction and runs them as PreSync on the FIRST sync, before
# postgres exists -> they fail -> the Sync phase never applies the DB -> deadlock.
# The wave20-ryax-bootstrap.yaml Job breaks this by doing the first sync with
# `argocd app sync ryax --skip-hooks`, then a normal sync once the DB is up.
# See deployment/apps/ryax/README.md for the full analysis + upstream-fix hints.
#
# Multi-source (same shape as wave20-zulip.yaml for the OCI chart):
#   1. ryax-engine OCI Helm chart
#   2. ref source for $values
#   3. Git directory: haproxy ingress, admin sealed secret, authentik tile
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ryax
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "20"
spec:
  project: default
  sources:
    - repoURL: oci://registry.ryax.org/release-charts/ryax-engine
      chart: ryax-engine
      # renovate: datasource=docker depName=registry.ryax.org/release-charts/ryax-engine
      targetRevision: "26.4.0"
      helm:
        releaseName: ryax
        valueFiles:
          - $values/deployment/apps/ryax/values.yaml

    - repoURL: git@github.com:paraXent/infra.git
      targetRevision: main
      ref: values

    - repoURL: git@github.com:paraXent/infra.git
      targetRevision: main
      path: deployment/apps/ryax
      directory:
        exclude: "{values.yaml,*.sh,*.template,README.md}"

  destination:
    server: https://kubernetes.default.svc
    namespace: ryaxns

  # The chart re-renders many Secrets with `lookup() | default randAlphaNum`. ArgoCD's
  # repo-server runs `helm template` WITHOUT cluster access, so lookup() is empty and a
  # NEW random value is rendered every sync. Without these ignores, selfHeal would rewrite
  # the live passwords on every reconcile and break running pods. We ignore .data on ALL
  # Secrets (name-less) so each is frozen at its first-applied value — robust to the chart's
  # release-name-derived secret names across versions. The only non-chart Secret here is the
  # SealedSecret CR (different kind, bitnami.com/v1alpha1), which is untouched. PVC immutable
  # fields and the Prometheus CRDs (owned by the cluster's main kube-prometheus-stack) are
  # ignored for the same "stop perpetual OutOfSync" reason. See deployment/apps/ryax/README.md.
  ignoreDifferences:
    # All chart-rendered Secrets: freeze .data at first apply (lookup() churn).
    - group: ""
      kind: Secret
      jqPathExpressions: [".data"]
    # All PVCs: storageClassName/volumeName/volumeMode/resources are immutable once
    # bound; SSA can't reconcile them back to chart defaults.
    - group: ""
      kind: PersistentVolumeClaim
      jsonPointers:
        - /spec/storageClassName
        - /spec/volumeName
        - /spec/volumeMode
        - /spec/resources
    # Ingress class may be defaulted by the cluster; ignore to avoid churn.
    - group: networking.k8s.io
      kind: Ingress
      jqPathExpressions: [".spec.ingressClassName"]
    # Prometheus CRDs are owned by the cluster's main kube-prometheus-stack (prometheus
    # namespace); the ryax subchart ships an older version -> ignore spec + annotations.
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: alertmanagerconfigs.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: alertmanagers.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: podmonitors.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: probes.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: prometheusagents.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: prometheuses.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: prometheusrules.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: scrapeconfigs.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: servicemonitors.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      name: thanosrulers.monitoring.coreos.com
      jqPathExpressions: [".spec", ".metadata.annotations"]

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
      - RespectIgnoreDifferences=true
