{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],

    "argocd": {
        "managerFilePatterns": ["/deployment/apps/.+\\.yaml$/", "/deployment/.+/.+\\.yaml$/"]
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Pulumi helm.v3.Release versions in TypeScript source",
            "managerFilePatterns": ["/src/.+\\.ts$/"],
            "matchStrings": [
                "chart: \"(?<depName>[^\"]+)\",(?:[^\\n]*\\n){1,3}[^\\n]*version: \"(?<currentValue>[^\"]+)\",[^\\n]*\\n(?:[^\\n]*\\n){0,2}[^\\n]*repositoryOpts: \\{ repo: \"(?<registryUrl>[^\"]+)\""
            ],
            "datasourceTemplate": "helm"
        },
        {
            "customType": "regex",
            "description": "Tool versions in scripts/environment/install.sh",
            "managerFilePatterns": ["/scripts/install\\.sh/"],
            "matchStrings": [
                "[A-Z_]+=\"(?<currentValue>[^\"]+)\"\\s+# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)"
            ]
        },
        {
            "customType": "regex",
            "description": "ArgoCD Helm Application targetRevision in deployment manifests",
            "managerFilePatterns": ["/deployment/.+\\.ya?ml$/"],
            "matchStrings": [
                "repoURL:\\s*\"?(?<registryUrl>https?://[^\"\\n]+)\"?(?:[^\\n]*\\n){0,12}?chart:\\s*\"?(?<depName>[^\"\\n]+)\"?(?:[^\\n]*\\n){0,8}?targetRevision:\\s*\"?(?<currentValue>[^\"\\n# ]+)"
            ],
            "datasourceTemplate": "helm"
        },
        {
            "customType": "regex",
            "description": "Git targetRevision values annotated with renovate comments",
            "managerFilePatterns": ["/deployment/.+\\.ya?ml$/"],
            "matchStrings": [
                "targetRevision:\\s*\"(?<currentValue>[^\"]+)\"\\s+#\\s*renovate:\\s+datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?"
            ]
        },
        {
            "customType": "regex",
            "description": "upgrade.cattle.io Plan version fields annotated with renovate comments",
            "managerFilePatterns": ["/deployment/.+\\.ya?ml$/"],
            "matchStrings": [
                "version:\\s*\"(?<currentValue>[^\"]+)\"\\s+#\\s*renovate:\\s+datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?"
            ]
        },
        {
            "customType": "regex",
            "description": "YAML tag fields annotated with renovate comments",
            "managerFilePatterns": ["/deployment/.+\\.ya?ml$/"],
            "matchStrings": [
                "tag:\\s*\"(?<currentValue>[^\"]+)\"\\s+#\\s*renovate:\\s+datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?"
            ]
        },
        {
            "customType": "regex",
            "description": "Container image tags in deployment manifests",
            "managerFilePatterns": ["/deployment/.+\\.ya?ml$/"],
            "matchStrings": [
                "image:\\s*\"?(?<depName>[a-z0-9./_-]+):(?<currentValue>[A-Za-z0-9._-]+)(?:@sha256:[a-f0-9]{64})?\"?"
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": "Catch-all: group everything not matched by a specific rule",
            "matchFileNames": ["**/*"],
            "groupName": "Update all"
        },
        {
            "description": "Suppress bad ArgoCD OCI depName for zulip helm chart (chart name equals last path segment, causing double-append)",
            "matchDepNames": ["ghcr.io/zulip/helm-charts/zulip/zulip"],
            "enabled": false
        },
        {
            "description": "Fix double https:// in sourceUrl for external-dns-hetzner-webhook (OCI label already contains https://)",
            "matchDepNames": ["ghcr.io/mconfalonieri/external-dns-hetzner-webhook"],
            "sourceUrl": "https://github.com/mconfalonieri/external-dns-hetzner-webhook"
        },
        {
            "description": "Suppress ArgoCD git-tags lookup for system-upgrade-controller (git source without chart; github-releases annotation handles it)",
            "matchDepNames": ["https://github.com/rancher/system-upgrade-controller"],
            "matchDatasources": ["git-tags"],
            "enabled": false
        },
        {
            "description": "Pulumi infrastructure – minor updates",
            "matchFileNames": ["package.json", "package-lock.json", ".devcontainer/**", "src/**", "scripts/**"],
            "matchUpdateTypes": ["minor"],
            "groupName": "Pulumi infrastructure (minor)"
        },
        {
            "description": "Pulumi infrastructure – patch updates (automerge)",
            "matchFileNames": ["package.json", "package-lock.json", ".devcontainer/**", "src/**", "scripts/**"],
            "matchUpdateTypes": ["patch"],
            "groupName": "Pulumi infrastructure (patch)",
            "automerge": true,
            "automergeType": "branch"
        },
        {
            "description": "Pulumi infrastructure – major updates",
            "matchFileNames": ["package.json", "package-lock.json", ".devcontainer/**", "src/**", "scripts/**"],
            "matchUpdateTypes": ["major"],
            "groupName": "Pulumi infrastructure"
        },
        {
            "description": "Kubernetes infrastructure – minor updates",
            "matchFileNames": ["deployment/infrastructure/**", "deployment/argocd-sync-waves/wave[0-9]-*", "deployment/argocd-sync-waves/wave1[0-9]-*"],
            "matchUpdateTypes": ["minor"],
            "groupName": "Kubernetes infrastructure (minor)"
        },
        {
            "description": "Kubernetes infrastructure – patch updates (automerge)",
            "matchFileNames": ["deployment/infrastructure/**", "deployment/argocd-sync-waves/wave[0-9]-*", "deployment/argocd-sync-waves/wave1[0-9]-*"],
            "matchUpdateTypes": ["patch"],
            "groupName": "Kubernetes infrastructure (patch)",
            "automerge": true,
            "automergeType": "branch"
        },
        {
            "description": "Kubernetes infrastructure – major updates",
            "matchFileNames": ["deployment/infrastructure/**", "deployment/argocd-sync-waves/wave[0-9]-*", "deployment/argocd-sync-waves/wave1[0-9]-*"],
            "matchUpdateTypes": ["major"],
            "groupName": "Kubernetes infrastructure"
        },
        {
            "description": "Apps – minor updates",
            "matchFileNames": ["deployment/apps/**", "deployment/argocd-sync-waves/wave[2-9][0-9]-*", "deployment/argocd-sync-waves/wave[1-9][0-9][0-9]-*"],
            "matchUpdateTypes": ["minor"],
            "groupName": "Apps (minor)"
        },
        {
            "description": "Apps – patch updates (automerge)",
            "matchFileNames": ["deployment/apps/**", "deployment/argocd-sync-waves/wave[2-9][0-9]-*", "deployment/argocd-sync-waves/wave[1-9][0-9][0-9]-*"],
            "matchUpdateTypes": ["patch"],
            "groupName": "Apps (patch)",
            "automerge": true,
            "automergeType": "branch"
        },
        {
            "description": "Apps – major updates",
            "matchFileNames": ["deployment/apps/**", "deployment/argocd-sync-waves/wave[2-9][0-9]-*", "deployment/argocd-sync-waves/wave[1-9][0-9][0-9]-*"],
            "matchUpdateTypes": ["major"],
            "groupName": "Apps"
        }
    ]
}
