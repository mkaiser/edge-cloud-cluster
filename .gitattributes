# Set default line ending bevaviour for all text files to LF
* text=auto eol=lf

# explicit LF für for scripts and config
*.sh text eol=lf
*.conf text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows scripts should keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# set execute bit for scripts 
*.sh eol=lf